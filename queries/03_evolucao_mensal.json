{
  "collection": "fato_entregas",
  "aggregate": [
    {
      "$group": {
        "_id": {
          "$dateToString": {
            "format": "%Y-%m",
            "date": "$datas.comprometida",
            "timezone": "UTC"
          }
        },
        "total_itens": {
          "$sum": 1
        },
        "itens_atrasados": {
          "$sum": {
            "$cond": [
              "$entrega.atrasada",
              1,
              0
            ]
          }
        },
        "dias_atraso_total": {
          "$sum": "$entrega.diasAtraso"
        },
        "media_dias_atraso": {
          "$avg": {
            "$cond": [
              "$entrega.atrasada",
              "$entrega.diasAtraso",
              null
            ]
          }
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "mes_compromisso": "$_id",
        "total_itens": 1,
        "itens_atrasados": 1,
        "dias_atraso_total": 1,
        "taxa_atraso_percentual": {
          "$round": [
            {
              "$multiply": [
                {
                  "$divide": [
                    "$itens_atrasados",
                    "$total_itens"
                  ]
                },
                100
              ]
            },
            2
          ]
        },
        "media_dias_atraso": {
          "$round": [
            "$media_dias_atraso",
            2
          ]
        }
      }
    },
    {
      "$sort": [
        {
          "name": "mes_compromisso",
          "direction": 1
        }
      ]
    }
  ]
}
