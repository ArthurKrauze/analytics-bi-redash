# MySQL TPC-H EXISTENTE, acessível pelo Windows (não é criado por este Compose)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=ALTERAR
MYSQL_DATABASE=tpch

# MongoDB local do Docker Compose
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=tpch_bi
ETL_LIMIT=10000
ETL_BATCH=1000

# Gerar duas chaves diferentes (veja README); NÃO versionar .env
REDASH_COOKIE_SECRET=ALTERAR_CHAVE_LONGA
REDASH_SECRET_KEY=ALTERAR_OUTRA_CHAVE_LONGA
